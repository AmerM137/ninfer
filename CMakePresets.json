{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows MSVC",
      "description": "Release build with MSVC and NVCC's supported cl host compiler.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "C:/libs/ffmpeg-n6.1.2;C:/libs/curl"
      }
    },
    {
      "name": "windows-clangcl",
      "displayName": "Windows clang-cl",
      "description": "Release C/C++ build with clang-cl; CUDA continues to use cl as its host compiler.",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build-clangcl",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CUDA_HOST_COMPILER": "cl"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows MSVC Debug",
      "description": "Debug build with MSVC and just-my-code debugging enabled.",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build-debug",
      "environment": {
        "CXXFLAGS": "/JMC"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "windows-clangcl-debug",
      "displayName": "Windows clang-cl Debug",
      "description": "Debug C/C++ build with clang-cl and just-my-code debugging enabled.",
      "inherits": "windows-clangcl",
      "binaryDir": "${sourceDir}/build-clangcl-debug",
      "environment": {
        "CXXFLAGS": "/JMC"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "windows-cuda-debug",
      "displayName": "Windows CUDA Debug",
      "description": "MSVC debug build with CUDA device debugging enabled.",
      "inherits": "windows-debug",
      "binaryDir": "${sourceDir}/build-cuda-debug",
      "cacheVariables": {
        "CMAKE_CUDA_FLAGS": "-G"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows"
    },
    {
      "name": "windows-clangcl",
      "configurePreset": "windows-clangcl"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-clangcl-debug",
      "configurePreset": "windows-clangcl-debug"
    },
    {
      "name": "windows-cuda-debug",
      "configurePreset": "windows-cuda-debug"
    }
  ]
}
